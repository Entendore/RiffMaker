<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1118">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#161B26"
        app:title="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <Button android:id="@+id/playButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/bpm"
            android:textColor="#C8CDE0" />

        <EditText android:id="@+id/bpmInput"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:inputType="number"
            android:maxLength="3"
            android:imeOptions="actionDone"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/swing"
            android:textColor="#C8CDE0" />

        <SeekBar android:id="@+id/swingSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />

        <TextView android:id="@+id/swingLabel"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#C8CDE0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/instrumentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instrument_default" />

        <Button android:id="@+id/metroButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/met_off" />

        <Button android:id="@+id/tuningButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tuning_standard" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button android:id="@+id/btnViewPiano"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/view_piano" />

        <Button android:id="@+id/btnViewTab"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/view_tab" />

        <Button android:id="@+id/btnViewSheet"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/view_sheet" />

        <Button android:id="@+id/modeButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/draw" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="#6C7590"
        android:text="@string/help_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView android:id="@+id/pianoScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.riffmaker.PianoRollView android:id="@+id/pianoRoll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/piano_roll_desc" />
        </HorizontalScrollView>

        <HorizontalScrollView android:id="@+id/tabScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.example.riffmaker.TabView android:id="@+id/tabView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/tab_desc" />
        </HorizontalScrollView>

        <ScrollView android:id="@+id/sheetScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#F7F5EE">

            <com.example.riffmaker.SheetView android:id="@+id/sheetView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sheet_desc" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
